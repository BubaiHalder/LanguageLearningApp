APP_ENV=development
AI_MODE=live
AI_HOST=127.0.0.1
AI_PORT=8000
AI_SERVICE_TOKEN=CHANGE_INTERNAL_SERVICE_TOKEN
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
AI_MODEL_ROOT=./models
WHISPER_MODEL_PATH=./models/whisper-small
VOICE_CATALOG_PATH=./voices.json
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AI_CPU_THREADS=4
AI_CONCURRENCY=1
AI_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=10485760
MAX_AUDIO_SECONDS=60
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# Windows defaults to sapi; Linux defaults to piper. Production permits piper only.
# TTS_ENGINE=sapi
