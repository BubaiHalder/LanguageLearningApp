APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=CHANGE_INTERNAL_SERVICE_TOKEN
AUTH_MODE=token
