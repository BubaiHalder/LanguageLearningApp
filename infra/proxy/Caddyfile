{
    admin off
    email {$ACME_EMAIL}
}
{$PUBLIC_DOMAIN} {
    request_body {
        max_size 11MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    @private path /metrics /docs /openapi.json /health/ready
    respond @private 404
    reverse_proxy api:3000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 130s
        }
    }
}
