APP_ENV=development
AI_MODE=live
AUTH_MODE=token
DEV_BIND_IP=127.0.0.1
API_PORT=3000
AI_SERVICE_TOKEN=CHANGE_INTERNAL_SERVICE_TOKEN
CLIENT_ACCESS_TOKEN=CHANGE_DISTINCT_DEVICE_TEST_TOKEN
METRICS_TOKEN=CHANGE_DISTINCT_MONITORING_TOKEN
INSTALL_AI_RUNTIMES=0
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_IMAGE=ollama/ollama:0.40.4
NODE_IMAGE=node:24-bookworm-slim
PYTHON_IMAGE=python:3.13-slim-bookworm
